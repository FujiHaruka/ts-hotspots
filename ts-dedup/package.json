{
  "name": "ts-dedup",
  "version": "0.1.0",
  "description": "Find duplicate TypeScript code — verbatim copies, renamed clones, and near-duplicates — across a PR or whole repo.",
  "keywords": [
    "typescript",
    "duplication",
    "clone-detection",
    "code-review",
    "static-analysis",
    "refactoring",
    "cli"
  ],
  "author": "Haruka Fuji",
  "homepage": "https://github.com/FujiHaruka/ts-dedup#readme",
  "bugs": {
    "url": "https://github.com/FujiHaruka/ts-dedup/issues"
  },
  "type": "module",
  "bin": {
    "ts-dedup": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FujiHaruka/ts-dedup.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm test && pnpm build",
    "start": "node src/index.ts",
    "bench": "node tools/bench/index.ts",
    "bench:scale": "node tools/bench/scale.ts",
    "bench:sweep": "node tools/bench/sweep.ts",
    "bench:sweep-self": "node tools/bench/sweepSelf.ts",
    "bench:ngram": "node tools/bench/microNgramBuild.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:strip-only": "node tools/check-strip-only.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck && pnpm check:strip-only"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "biome check --write",
      "eslint --fix"
    ],
    "*.{json,jsonc}": [
      "biome check --write"
    ]
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/node": "25.6.0",
    "eslint": "10.2.0",
    "lint-staged": "16.4.0",
    "simple-git-hooks": "2.13.1",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.4"
  }
}
