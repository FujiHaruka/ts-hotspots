{
  "name": "ts-hotspots",
  "version": "0.2.0",
  "description": "A CLI that statically analyzes a TypeScript project and surfaces refactor-candidate coordinates: per-function hotspots and Type-3 duplication groups.",
  "keywords": [
    "typescript",
    "static-analysis",
    "code-metrics",
    "hotspots",
    "duplication",
    "clone-detection",
    "refactoring",
    "cli",
    "ai-agent"
  ],
  "type": "module",
  "bin": {
    "ts-hotspots": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build",
    "start": "node src/index.ts",
    "test": "vitest run",
    "test:related": "vitest run --changed",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "bench": "node tools/bench/index.ts",
    "bench:scale": "node tools/bench/scale.ts",
    "bench:sweep": "node tools/bench/sweep.ts",
    "bench:sweep-self": "node tools/bench/sweepSelf.ts",
    "bench:ngram": "node tools/bench/microNgramBuild.ts",
    "perf:dup": "node tools/perf/dupMeasure.ts",
    "check:strip-only": "node tools/check-strip-only.ts",
    "knip": "knip",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck && pnpm check:strip-only && pnpm knip"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "biome check --write",
      "oxlint --fix"
    ],
    "*.{json,jsonc}": [
      "biome check --write"
    ]
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/node": "25.6.0",
    "knip": "6.7.0",
    "lint-staged": "16.4.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "0.21.1",
    "simple-git-hooks": "2.13.1",
    "vitest": "4.1.4"
  },
  "dependencies": {
    "commander": "14.0.3",
    "minimatch": "10.2.5",
    "typescript": "6.0.2",
    "yaml": "2.8.3"
  }
}
